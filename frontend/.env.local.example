# Copy to .env.local for development. All NEXT_PUBLIC_ values are inlined at
# build time, so a change in production needs a rebuild, not just a restart.

# Browser-side calls to the API. The backend runs in Docker and publishes 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Absolute origin of the public site. Canonical URLs, the sitemap and robots.txt
# are built from it, so it must be the real https origin in production -
# a wrong value here publishes wrong canonicals, which is worse than none.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=SheVaani

# Printed on the contact page. Razorpay's account review wants the business
# name, address, phone and email reachable on the site; a value left empty is
# simply not shown, so fill these before submitting for review.
NEXT_PUBLIC_COMPANY_LEGAL_NAME='Algoholic (OPC) Private Limited'
NEXT_PUBLIC_COMPANY_ADDRESS='Dhanbad, Jharkhand, India'
NEXT_PUBLIC_COMPANY_PHONE='+91 8797729837'
NEXT_PUBLIC_COMPANY_EMAIL='team@shevaani.com'
