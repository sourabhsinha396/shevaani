# Not here: whether a part of the product is switched on. "Should the site
# offer 1:1 sessions?" is a decision somebody makes on a Tuesday, not a
# property of the deployment, and a variable would mean a rebuild to change it.
# Those live in the `site_settings` table, edited at localhost:3000/admin/settings.
# What belongs below is anything the app needs before it can reach the database,
# or that genuinely differs between deployments.

# ---- Postgres container -----------------------------------------------
# Read by docker-compose.yaml to provision the db service. DATABASE_URL below
# must be built from the same three values. Defaults are fine locally; on the
# server set a real password (openssl rand -hex 24) BEFORE the first `up` —
# Postgres only reads these when initialising an empty data volume.
POSTGRES_USER=shevaani
POSTGRES_PASSWORD=shevaani
POSTGRES_DB=shevaani

# Host port the API is published on (loopback only). Several products share
# the production server, so give each its own port and point the reverse
# proxy at it. Inside the container uvicorn always listens on 8000.
WEB_PORT=8000

# ---- Core -------------------------------------------------------------
# development | test | staging | production. Anything that is not
# development/test/local is treated as deployed: API docs off, tracebacks
# withheld from responses. Staging gets the production treatment by default.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://shevaani:shevaani@db:5432/shevaani
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGIN=http://localhost:3000

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# How long a sign-in lasts. One session cookie, no refresh flow. Rotating
# JWT_SECRET signs everyone out, which is the revocation lever for all sessions
# at once; per-account, deactivate the user or change the password.
SESSION_TTL_DAYS=30

# Encrypts instructors' Google refresh tokens at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-fernet-key

# Development only: this password signs in to any account from the login form.
# The check is hard-gated on ENVIRONMENT being development/local/test, so it is
# inert on a deployed box even if set there. Leave empty to disable.
DEV_MASTER_PASSWORD=

# ---- Booking rules ----------------------------------------------------
# One-to-one sessions are bookable only inside this local window.
BOOKING_TIMEZONE=Asia/Kolkata
ONE_ON_ONE_WINDOW_START=07:00
ONE_ON_ONE_WINDOW_END=19:00
ONE_ON_ONE_BUFFER_MINUTES=60
ONE_ON_ONE_SLOT_MINUTES=60
# How long an unpaid booking holds its seat before the sweeper releases it.
BOOKING_HOLD_MINUTES=10
# Group sessions below min_seats this many hours before start are auto-cancelled.
GROUP_AUTOCANCEL_HOURS_BEFORE=2
# Cancel more than this many hours before the start for a full credit refund.
CANCELLATION_FULL_REFUND_HOURS=12
# Join link is served from T-15m until end+15m.
JOIN_WINDOW_BEFORE_MINUTES=15
JOIN_WINDOW_AFTER_MINUTES=15

# ---- Google (Calendar API, consumer Gmail accounts) -------------------
# Instructors connect their own Google account; we create the Calendar
# event + Meet link on THEIR calendar so they are the real Meet host.
# The same client id also powers "Sign in with Google" (POST /auth/google):
# set it as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend too, and add the
# site's origin under "Authorized JavaScript origins" in the Google console.
# Unset: the button is not rendered and the endpoint answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/instructors/google/callback

# ---- Payments ---------------------------------------------------------
# Webhook endpoints: POST /api/v1/webhooks/stripe and /api/v1/webhooks/razorpay
STRIPE_SECRET_KEY=
# From the Stripe dashboard's webhook endpoint (whsec_...), NOT the API key.
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set on the webhook itself in the Razorpay dashboard. This is NOT
# RAZORPAY_KEY_SECRET — using that value fails every signature check, which
# looks exactly like someone forging events at you.
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Brevo) ----------------------------------------------------
# Unset: mail is logged, not sent. That log is the inbox in development.
BREVO_API_KEY=
EMAIL_FROM=no-reply@shevaani.com
EMAIL_FROM_NAME=Shevaani
# Hours before a session that reminders go out. JSON list.
SESSION_REMINDER_HOURS=[24, 1]

# ---- Slack ------------------------------------------------------------
# Incoming webhook for operational notifications. Unset: nothing is posted,
# which is what keeps local development out of a real channel.
SLACK_WEBHOOK_URL=

# ---- Object storage (Cloudflare R2 / S3) ------------------------------
# Unset: falls back to the filesystem at LOCAL_STORAGE_DIR, so the whole app
# and the backup job run with no cloud account.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=/tmp/shevaani-storage

# ---- Backups ----------------------------------------------------------
# See docs/BACKUPS.md. The deliverable is `make restore-drill`, not the dump.
BACKUP_PREFIX=backups/postgres
BACKUP_RETENTION_DAYS=30
# UTC hour of the nightly run. 18 is 23:30 IST.
BACKUP_HOUR_UTC=18

# ---- Abuse controls ---------------------------------------------------
# reCAPTCHA v2 checkbox on login, registration and forgot-password.
# Unset: the check is skipped. Set it together with the frontend's
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY — the secret alone makes every login fail,
# because the forms would never render the widget that produces the token.
RECAPTCHA_SECRET_KEY=
RATE_LIMIT_ENABLED=true
# Only true when something in front of the app OVERWRITES X-Forwarded-For.
# If it merely appends, callers can forge it and every per-IP limit becomes
# opt-out.
TRUST_PROXY_HEADERS=false

# ---- API docs ---------------------------------------------------------
# Unset: /docs, /redoc and /openapi.json exist locally and nowhere else.
# Set true outside local and they return, behind superuser auth.
# EXPOSE_API_DOCS=false
